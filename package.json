{
  "name": "ipopilot",
  "description": "Automates applying for IPOs on MeroShare, Nepal's CDSC platform.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @ipopilot/db db:migrate",
    "db:seed": "pnpm --filter @ipopilot/db db:seed",
    "worker:dev": "pnpm --filter @ipopilot/worker dev",
    "worker:test-login": "pnpm --filter @ipopilot/meroshare-client test-login"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.2.0",
    "eslint": "^8.57.0"
  }
}
