// IPOBaje — Prisma database schema
// PostgreSQL 16, Prisma 5.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum IssueStatus {
  OPEN
  CLOSED
  RESULT_PUBLISHED
}

enum ApplicationStatus {
  PENDING
  APPLYING
  APPLIED
  ALLOTTED
  NOT_ALLOTTED
  FAILED
  SKIPPED
}

enum NotificationType {
  NEW_IPO_OPEN
  NEW_ISSUE_DETECTED
  AUTO_APPLY_SUCCESS
  AUTO_APPLY_FAILED
  RESULT_ALLOTTED
  RESULT_NOT_ALLOTTED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  hashedPassword String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  accounts       MeroShareAccount[]
  notifications  Notification[]
}

model MeroShareAccount {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  boid              String          // 16-digit demat account ID
  username          String?         // Original MeroShare login username (may differ from BOID)
  dpId              Int
  dpName            String
  fullName          String?
  encryptedPassword String          // AES-256-GCM ciphertext (hex)
  encryptionIv      String          // 12-byte IV (hex)
  encryptionTag     String          // 16-byte GCM auth tag (hex)
  encryptedTransactionPin String?   // AES-256-GCM ciphertext (hex) — required to actually submit an application
  transactionPinIv       String?
  transactionPinTag      String?
  bankId            Int?
  bankName          String?
  accountNumber     String?
  accountBranchId   Int?
  crnNumber         String?
  customerId        Int?
  isActive          Boolean         @default(true)
  lastLoginAt       DateTime?
  lastAppliedAt     DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  applications      IPOApplication[]

  @@unique([userId, boid])
}

model IPOIssue {
  id             String          @id @default(cuid())
  companyShareId Int             @unique // CDSC's own primary key
  scrip          String
  companyName    String
  shareType      String          // "IPO" | "FPO" | "RIGHT"
  shareGroup     String          // "Ordinary" | "Promoter"
  status         IssueStatus     @default(OPEN)
  openDate       DateTime
  closeDate      DateTime
  issuePrice     Decimal?        @db.Decimal(10, 2)
  minUnit        Int
  maxUnit        Int
  prospectusUrl  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  applications   IPOApplication[]
}

model IPOApplication {
  id              String            @id @default(cuid())
  accountId       String
  account         MeroShareAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  issueId         String
  issue           IPOIssue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  appliedKitta    Int
  appliedAt       DateTime?
  status          ApplicationStatus @default(PENDING)
  allottedKitta   Int?
  resultCheckedAt DateTime?
  errorMessage    String?
  retryCount      Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([accountId, issueId])
}

// A row scraped from CDSC's public "Current Issue Update" page (cdsc.com.np/ipolist).
// That page is publicly readable (unlike MeroShare's application backend, which
// blocks automated access) but only carries subscription-progress fields — it's
// missing companyShareId and per-applicant min/max unit, so a detected issue sits
// here until a user completes those and it's promoted into a real IPOIssue.
model DetectedIssue {
  id             String    @id @default(cuid())
  companyName    String    @unique
  shareTypeRaw   String?
  issueManager   String?
  openDate       DateTime
  closeDate      DateTime
  estimatedPrice Decimal?  @db.Decimal(10, 2)
  detectedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}
