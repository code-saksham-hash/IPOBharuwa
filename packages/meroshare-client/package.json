{
  "name": "@ipopilot/meroshare-client",
  "version": "0.0.0",
  "private": false,
  "description": "Unofficial TypeScript client for the MeroShare CDSC REST API",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-login": "tsx test-login.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^1.6.0"
  }
}
